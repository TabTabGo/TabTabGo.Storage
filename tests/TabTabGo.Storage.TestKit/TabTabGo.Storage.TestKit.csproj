<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared test helpers; not a test project and never packed. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>TabTabGo.Storage.TestKit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="TabTabGo.Data.EF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TabTabGo.Storage\TabTabGo.Storage.csproj" />
    <ProjectReference Include="..\..\src\TabTabGo.Storage.Data.EF\TabTabGo.Storage.Data.EF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The golden capture tool is built separately by Golden/capture/capture.py against the 6.0.8.4 sources. -->
    <Compile Remove="Golden/capture/**" />
    <None Remove="Golden/capture/**" />
    <None Update="Golden\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
