<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Bounded range: a Storage line never floats onto another Core major. A local build overrides it with the
         environment variable or -p:TabTabGoCoreVersion=10.0.0-local.<sha> (see scripts/local-core.py). Never committed
         with a -local value; release.yml checks this default. -->
    <TabTabGoCoreVersion Condition="'$(TabTabGoCoreVersion)' == ''">[10.0.0, 11.0.0)</TabTabGoCoreVersion>
  </PropertyGroup>

  <ItemGroup Label="TabTabGo Core">
    <PackageVersion Include="TabTabGo.Core" Version="$(TabTabGoCoreVersion)" />
    <PackageVersion Include="TabTabGo.Core.Services" Version="$(TabTabGoCoreVersion)" />
    <PackageVersion Include="TabTabGo.Data.EF" Version="$(TabTabGoCoreVersion)" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions / EF Core (v10 line)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Providers">
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.8" />
    <!-- v10 takes the current 12.30.x (Azure.Core 1.5x needs Microsoft.Extensions.* 10.x, which net10.0 provides). -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="SkiaSharp" Version="4.154.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <!-- Microsoft.EntityFrameworkCore.SqlServer 10.0.14 brings System.Security.Cryptography.Pkcs 9.0.11 (moderate + high advisories); pinned up here (test project only). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.LocalStack" Version="4.16.0" />
  </ItemGroup>

</Project>
