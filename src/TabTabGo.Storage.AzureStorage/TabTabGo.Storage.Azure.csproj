<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>TabTabGo Storage Azure Blob</Title>
    <Product>TabTabGo Azure Storage</Product>
    <Description>IStorageProvider implementation on Azure Blob Storage, with connection-string or token-credential authentication.</Description>
    <PackageTags>Storage;Azure;Blob;TabTabGo</PackageTags>
    <AssemblyName>TabTabGo.Storage.Azure</AssemblyName>
    <RootNamespace>TabTabGo.Storage.AzureStorage</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" />
    <!-- Azure.Core 1.60 (via Azure.Storage.Blobs 12.30.1) requires Microsoft.Extensions.* 10.0.9 even on net8.0,
         so this package cannot stay on the 8.0.x Extensions line. Reported to the architect. -->
    <PackageReference Include="Microsoft.Extensions.Options" VersionOverride="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" VersionOverride="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabTabGo.Storage.Azure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabTabGo.Storage\TabTabGo.Storage.csproj" />
  </ItemGroup>

</Project>
